generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// 1. TABLAS DEL LANDING PAGE (Ventas)
// ==========================================

model Prospecto {
  id              String   @id @default(uuid())
  nombre          String
  telefono        String
  email           String?
  ciudadPropiedad String
  mensaje         String?
  fechaReunion    String?  
  horaReunion     String?  
  estado          String   @default("NUEVO")
  fechaCreacion   DateTime @default(now())
}

// ==========================================
// 2. TABLA CENTRAL DE USUARIOS
// ==========================================

enum RolUsuario {
  ADMIN
  AMA_LLAVES
  ASEO
  PROPIETARIO
}

model Usuario {
  id        String     @id @default(uuid())
  nombre    String     
  username  String     @unique 
  password  String     
  rol       RolUsuario 
  createdAt DateTime   @default(now())

  // Relaciones
  propiedades  Propiedad[]  @relation("PropietarioPropiedad")
  tareas_aseo  TareasAseo[] @relation("EmpleadoAseo")
}

// ==========================================
// 3. ECOSISTEMA DE PROPIEDADES Y OPERACIÓN
// ==========================================

model Propiedad {
  id                  String   @id @default(uuid())
  
  // 1. Describe tu espacio
  tipo_propiedad      String?  
  tipo_alojamiento    String?  
  pais                String?
  direccion           String?
  ciudad              String?
  departamento        String?
  capacidad_huespedes Int?
  habitaciones        Int?
  camas               Int?
  banos               Int?

  // 2. Haz que destaque
  comodidades         String[] 
  fotos               String[] 
  foto_categorias     String[] @default([]) 
  titulo              String?
  descripcion         String?

  // 3. Terminar y publicar (TARIFAS BASE)
  precio_noche         Float?
  huespedes_base       Int?      @default(1)
  precio_huesped_extra Float?    @default(0)
  precio_mascota       Float?    @default(0)
  tarifa_aseo          Float?    @default(0) 
  descuentos           Json?    
  seguridad            String[] 

  // Operación interna (Lo que ven los empleados)
  wifi_red            String?
  wifi_pass           String?
  cerradura_codigo    String?

  // Enlaces de OTA's
  link_airbnb         String?
  link_booking        String?

  // Coordenadas precisas para el mapa interactivo
  lat                 Float?
  lng                 Float?
  
  // Relaciones
  propietario_id      String?
  propietario         Usuario?      @relation("PropietarioPropiedad", fields: [propietario_id], references: [id])
  
  // ✨ NUEVO CAJÓN MÁGICO DE INVENTARIO ✨
  inventario          Json?         @default("{}")
  
  reservas            Reserva[]
  tareas_aseo         TareasAseo[]
  liquidaciones       Liquidacion[]

  // Relación con las tarifas dinámicas
  tarifas_especiales  TarifaEspecial[] 

  created_at          DateTime @default(now())

  // ==========================================
  // 🔗 CONEXIÓN CON PRICELABS
  // ==========================================
  pricelabs_listing_id String?      // ID del listing en PriceLabs
  pricelabs_pms        String?      // 'airbnb', 'hostaway', 'lodgify', 'pms'...
  pricelabs_activo     Boolean      @default(false)
  pricelabs_moneda     String?      // moneda que reporta PriceLabs (debe ser COP)
  pricelabs_ajuste_pct Float?       @default(0)  // margen venta directa: -10 = 10% menos
  pricelabs_sync_at    DateTime?    // última sincronización exitosa

  precios_pricelabs    PrecioPricelabs[]
}

model Reserva {
  id                 String    @id @default(uuid())
  propiedad_id       String
  propiedad          Propiedad @relation(fields: [propiedad_id], references: [id], onDelete: Cascade)
  
  huesped_nombre     String
  check_in           DateTime
  check_out          DateTime
  canal              String   
  monto_total        Float
  cantidad_huespedes Int       @default(1) // Mantenemos por las reservas viejas

  // ✨ NUEVOS CAMPOS DETALLADOS DE HUÉSPEDES ✨
  adultos            Int       @default(1)
  ninos              Int       @default(0)
  bebes              Int       @default(0)
  mascotas           Int       @default(0)

  estado_reserva     String    @default("Confirmada")
  created_at         DateTime  @default(now())
}

model TarifaEspecial {
  id            String    @id @default(uuid())
  propiedad_id  String
  propiedad     Propiedad @relation(fields: [propiedad_id], references: [id], onDelete: Cascade)
  
  fecha_inicio  DateTime
  fecha_fin     DateTime
  precio        Float
  
  created_at    DateTime  @default(now())
}

/// Caché diario de precios recomendados por PriceLabs.
/// La web SIEMPRE lee de aquí, nunca de PriceLabs en vivo.
model PrecioPricelabs {
  id              String    @id @default(uuid())
  propiedad_id    String
  propiedad       Propiedad @relation(fields: [propiedad_id], references: [id], onDelete: Cascade)

  fecha           DateTime  @db.Date
  precio          Float     // precio final ya con el ajuste_pct aplicado
  precio_original Float     // precio crudo de PriceLabs, para auditar
  min_estadia     Int?
  moneda          String?
  demanda         String?   // "Low Demand", "High Demand"...
  reservado       Boolean   @default(false)

  actualizado     DateTime  @updatedAt

  @@unique([propiedad_id, fecha])
  @@index([propiedad_id, fecha])
}

model TareasAseo {
  id                String    @id @default(uuid())
  propiedad_id      String
  propiedad         Propiedad @relation(fields: [propiedad_id], references: [id], onDelete: Cascade)
  
  empleado_id       String?
  empleado          Usuario?  @relation("EmpleadoAseo", fields: [empleado_id], references: [id])
  
  urgencia          String    
  estado            String    @default("Pendiente") 
  tiempo_segundos   Int       @default(0)
  novedad_reportada String?
  
  // ✨ NUEVO CAJÓN MÁGICO PARA EL REPORTE DEL EMPLEADO ✨
  reporte_empleado  Json?
  
  created_at        DateTime  @default(now())
  completed_at      DateTime?
}

// ==========================================
// 4. MÓDULO FINANCIERO
// ==========================================

model Liquidacion {
  id             String    @id @default(uuid())
  propiedad_id   String
  mes_anio       String
  archivo_pdf    String    
  nombre_archivo String
  created_at     DateTime  @default(now())

  propiedad      Propiedad @relation(fields: [propiedad_id], references: [id], onDelete: Cascade)
}

// ==========================================
// 5. OTROS MÓDULOS
// ==========================================

model Disponibilidad {
  id         String   @id @default(uuid())
  diaSemana  Int      
  hora       String   
  activo     Boolean  @default(true)
  created_at DateTime @default(now())

  @@unique([diaSemana, hora]) 
}

model ArticuloBlog {
  id             Int      @id @default(autoincrement())
  titulo         String
  categoria      String
  tiempo_lectura Int
  foto_url       String?  
  contenido      String   
  estado         String   @default("Publicado")
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt 
}